<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ECDL / ICDL Modul 1 – Quiz</title>
  <style>
    :root {
      --bg: #f5f7fb;
      --card: #ffffff;
      --text: #1f2937;
      --muted: #6b7280;
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --success: #16a34a;
      --error: #dc2626;
      --warning: #d97706;
      --border: #e5e7eb;
      --shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
      --radius: 16px;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: linear-gradient(180deg, #eef4ff 0%, var(--bg) 220px);
      color: var(--text);
      line-height: 1.55;
    }

    button, select, input { font: inherit; }

    .quiz-container {
      width: min(960px, calc(100% - 28px));
      margin: 32px auto 64px;
    }

    .hero {
      background: rgba(255,255,255,.92);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,.75);
      box-shadow: var(--shadow);
      border-radius: 24px;
      padding: 28px;
      margin-bottom: 22px;
    }

    .header-area {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: flex-start;
      flex-wrap: wrap;
    }

    h1 { margin: 0; font-size: clamp(1.6rem, 4vw, 2.35rem); line-height: 1.15; }
    .subtitle { margin-top: 8px; color: var(--muted); }

    .timer-display {
      display: none;
      font-weight: 800;
      color: var(--error);
      background: #fef2f2;
      border: 1px solid #fecaca;
      padding: 9px 13px;
      border-radius: 999px;
      white-space: nowrap;
    }

    .progress-wrap { margin-top: 24px; }
    .progress-row { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); font-size: .92rem; margin-bottom: 8px; }
    .progress-track { height: 10px; background: #e8edf6; border-radius: 999px; overflow: hidden; }
    .progress-bar { height: 100%; width: 0; background: var(--primary); transition: width .25s ease; }

    .settings-panel {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
      margin-top: 22px;
    }

    .setting-group, .switch-container {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .setting-group { justify-content: space-between; }
    .switch-container { cursor: pointer; }
    .switch-container input { width: 18px; height: 18px; accent-color: var(--primary); }

    select {
      border: 1px solid #cbd5e1;
      background: #fff;
      padding: 8px 10px;
      border-radius: 10px;
      color: var(--text);
    }

    .controls {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 18px 0 22px;
    }

    .btn {
      border: none;
      padding: 11px 16px;
      border-radius: 12px;
      font-weight: 750;
      cursor: pointer;
      transition: transform .15s ease, background .15s ease, opacity .15s ease;
    }

    .btn:hover { transform: translateY(-1px); }
    .btn:disabled { opacity: .55; cursor: not-allowed; transform: none; }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-primary:hover { background: var(--primary-dark); }
    .btn-secondary { background: #e8edf6; color: var(--text); }

    .question-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 0 6px 18px rgba(15, 23, 42, .05);
      padding: 22px;
      margin-bottom: 16px;
    }

    .question-top { display: flex; justify-content: space-between; gap: 14px; align-items: center; margin-bottom: 10px; }
    .topic-badge {
      display: inline-flex;
      align-items: center;
      padding: 5px 9px;
      border-radius: 999px;
      background: #eff6ff;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: .05em;
      font-size: .72rem;
      font-weight: 800;
    }
    .question-number { color: var(--muted); font-size: .9rem; }
    .question-text { font-size: 1.08rem; font-weight: 800; margin: 8px 0 14px; }

    .options-list { display: grid; gap: 10px; }
    .option-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 14px;
      cursor: pointer;
      background: #fff;
      transition: border-color .15s ease, background .15s ease, transform .15s ease;
    }
    .option-item:hover { border-color: #93c5fd; background: #f8fbff; transform: translateY(-1px); }
    .option-item input { margin-top: 3px; accent-color: var(--primary); }
    .option-item.selected-pre { border-color: var(--primary); background: #eff6ff; }
    .option-item.correct { border-color: #86efac; background: #f0fdf4; color: #166534; }
    .option-item.incorrect { border-color: #fecaca; background: #fef2f2; color: #991b1b; }

    .hint-btn {
      margin-top: 12px;
      border: none;
      background: transparent;
      color: var(--primary);
      font-weight: 700;
      cursor: pointer;
      padding: 0;
    }
    .hint-text, .feedback {
      display: none;
      margin-top: 10px;
      border-left: 4px solid #bfdbfe;
      background: #f8fbff;
      padding: 10px 12px;
      border-radius: 8px;
      color: #475569;
    }
    .hint-text.show, .feedback.show { display: block; }
    .feedback.correct-feedback { border-left-color: #86efac; background: #f0fdf4; }
    .feedback.incorrect-feedback { border-left-color: #fecaca; background: #fef2f2; }

    #result-box {
      display: none;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 24px;
      margin-top: 22px;
    }
    #result-box.show { display: block; }
    .result-score { font-size: 2rem; font-weight: 900; margin-bottom: 6px; }
    .result-meta { color: var(--muted); }

    @media (max-width: 640px) {
      .quiz-container { width: min(100% - 18px, 960px); margin-top: 10px; }
      .hero, .question-card, #result-box { padding: 17px; border-radius: 14px; }
      .controls { position: sticky; bottom: 8px; z-index: 5; padding: 10px; background: rgba(245,247,251,.92); backdrop-filter: blur(8px); border-radius: 14px; }
      .controls .btn { flex: 1 1 160px; }
    }
  </style>
</head>
<body>
  <main class="quiz-container">
    <section class="hero">
      <div class="header-area">
        <div>
          <h1 id="ui-title">ECDL / ICDL Modul 1 Grundlagen</h1>
          <div id="ui-subtitle" class="subtitle">Interaktives Übungs-Quiz</div>
        </div>
        <div id="timer-box" class="timer-display">⏱️ 45:00</div>
      </div>

      <div class="progress-wrap">
        <div class="progress-row">
          <span id="ui-progress-label">Fortschritt</span>
          <span id="progress-text">0 / 10 beantwortet</span>
        </div>
        <div class="progress-track"><div id="progress-bar" class="progress-bar"></div></div>
      </div>

      <div class="settings-panel">
        <div class="setting-group">
          <label for="lang-select">🌐 Sprache</label>
          <select id="lang-select" onchange="changeLanguage(this.value)">
            <option value="de">Deutsch</option>
            <option value="en">English</option>
            <option value="uk">Українська</option>
          </select>
        </div>

        <label class="switch-container">
          <input type="checkbox" id="mode-checkbox" checked onchange="toggleExamMode()" />
          <span id="ui-mode-text">🎓 Übungsmodus</span>
        </label>
      </div>
    </section>

    <div class="controls">
      <button id="ui-btn-shuffle" class="btn btn-secondary" onclick="shuffleAndReset()">🔄 Neu mischen</button>
      <button id="calc-score-btn" class="btn btn-primary" onclick="calculateScore(false)">📋 Quiz auswerten</button>
    </div>

    <section id="quiz-questions" aria-live="polite"></section>
    <section id="result-box" aria-live="polite"></section>
  </main>

  <script>
    const translations = {
      de: {
