        subtitle: 'Interaktives Übungs-Quiz',
        progress: 'Fortschritt', answered: 'beantwortet',
        practice: '🎓 Übungsmodus', exam: '⏱️ Prüfungsmodus',
        shuffle: '🔄 Neu mischen', evaluate: '📋 Quiz auswerten',
        hint: '💡 Hinweis anzeigen', correct: 'Richtig!', wrong: 'Nicht ganz.',
        unanswered: 'Bitte beantworte zuerst alle Fragen.',
        result: 'Ergebnis', of: 'von', points: 'Punkten',
        excellent: 'Sehr stark!', good: 'Gut gemacht.', improve: 'Da geht noch mehr – probiere es noch einmal.'
      },
