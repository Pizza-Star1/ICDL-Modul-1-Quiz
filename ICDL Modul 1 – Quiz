        progress: 'Progress', answered: 'answered',
        practice: '🎓 Practice mode', exam: '⏱️ Exam mode',
        shuffle: '🔄 Shuffle again', evaluate: '📋 Evaluate quiz',
        hint: '💡 Show hint', correct: 'Correct!', wrong: 'Not quite.',
        unanswered: 'Please answer all questions first.',
        result: 'Result', of: 'of', points: 'points',
        excellent: 'Excellent!', good: 'Good job.', improve: 'Keep practicing and try again.'
      },
      uk: {
        title: 'ECDL / ICDL Модуль 1 Основи',
        subtitle: 'Інтерактивний тренувальний тест',
        progress: 'Прогрес', answered: 'відповіли',
        practice: '🎓 Режим навчання', exam: '⏱️ Режим іспиту',
        shuffle: '🔄 Перемішати', evaluate: '📋 Перевірити тест',
        hint: '💡 Показати підказку', correct: 'Правильно!', wrong: 'Не зовсім.',
        unanswered: 'Спочатку дайте відповідь на всі запитання.',
        result: 'Результат', of: 'з', points: 'балів',
        excellent: 'Відмінно!', good: 'Добре!', improve: 'Спробуйте ще раз для кращого результату.'
      }
    };

    const originalQuizData = [
      {
        topic: 'Hardware',
        q: {de:'Welche Komponente führt die meisten Berechnungen eines Computers aus?', en:'Which component performs most computer calculations?', uk:'Який компонент виконує більшість обчислень комп’ютера?'},
        options: [
          {de:'CPU / Prozessor', en:'CPU / Processor', uk:'CPU / Процесор'},
          {de:'Monitor', en:'Monitor', uk:'Монітор'},
          {de:'Tastatur', en:'Keyboard', uk:'Клавіатура'},
          {de:'Drucker', en:'Printer', uk:'Принтер'}
        ], correct: 0,
        hint: {de:'Sie wird oft als „Gehirn“ des Computers bezeichnet.', en:'It is often called the brain of the computer.', uk:'Його часто називають «мозком» комп’ютера.'}
      },
      {
        topic: 'Speicher',
        q: {de:'Welche Speicherart ist flüchtig und verliert Daten beim Ausschalten?', en:'Which type of memory is volatile and loses data when power is off?', uk:'Який тип пам’яті є енергозалежним і втрачає дані після вимкнення?'},
        options: [
          {de:'RAM', en:'RAM', uk:'RAM'},
          {de:'SSD', en:'SSD', uk:'SSD'},
          {de:'USB-Stick', en:'USB drive', uk:'USB-накопичувач'},
          {de:'DVD', en:'DVD', uk:'DVD'}
        ], correct: 0,
        hint: {de:'Arbeitsspeicher wird nur während des Betriebs benötigt.', en:'Working memory is used while the computer is running.', uk:'Оперативна пам’ять використовується під час роботи комп’ютера.'}
      },
      {
        topic: 'Software',
        q: {de:'Welche Software verwaltet Hardware und Programme eines Computers?', en:'Which software manages a computer’s hardware and applications?', uk:'Яке програмне забезпечення керує апаратним забезпеченням і програмами комп’ютера?'},
        options: [
          {de:'Betriebssystem', en:'Operating system', uk:'Операційна система'},
          {de:'Textverarbeitung', en:'Word processor', uk:'Текстовий редактор'},
          {de:'Webseite', en:'Website', uk:'Вебсайт'},
          {de:'Tabellenkalkulation', en:'Spreadsheet', uk:'Електронна таблиця'}
        ], correct: 0,
        hint: {de:'Windows, macOS und Linux sind Beispiele.', en:'Windows, macOS and Linux are examples.', uk:'Windows, macOS і Linux — приклади.'}
      },
      {
        topic: 'Netzwerk',
        q: {de:'Wofür steht die Abkürzung WLAN?', en:'What does WLAN refer to?', uk:'Що означає WLAN?'},
        options: [
          {de:'Drahtloses lokales Netzwerk', en:'Wireless local area network', uk:'Бездротова локальна мережа'},
          {de:'Ein Betriebssystem', en:'An operating system', uk:'Операційна система'},
          {de:'Eine Dateiendung', en:'A file extension', uk:'Розширення файлу'},
          {de:'Ein Druckeranschluss', en:'A printer port', uk:'Порт принтера'}
        ], correct: 0,
        hint: {de:'Es ist ein lokales Netzwerk ohne Kabel.', en:'It is a local network without cables.', uk:'Це локальна мережа без кабелів.'}
      },
      {
        topic: 'Internet',
        q: {de:'Welche Anwendung nutzt man typischerweise zum Aufrufen von Webseiten?', en:'Which application is typically used to open websites?', uk:'Яку програму зазвичай використовують для відкриття вебсайтів?'},
        options: [
          {de:'Webbrowser', en:'Web browser', uk:'Веббраузер'},
          {de:'Taschenrechner', en:'Calculator', uk:'Калькулятор'},
          {de:'Dateimanager', en:'File manager', uk:'Файловий менеджер'},
          {de:'Bildschirmtastatur', en:'On-screen keyboard', uk:'Екранна клавіатура'}
        ], correct: 0,
        hint: {de:'Chrome, Firefox, Edge und Safari gehören dazu.', en:'Chrome, Firefox, Edge and Safari are examples.', uk:'Chrome, Firefox, Edge і Safari — приклади.'}
      },
      {
        topic: 'Sicherheit',
        q: {de:'Welches Passwort ist am sichersten?', en:'Which password is the most secure?', uk:'Який пароль є найбезпечнішим?'},
        options: [
          {de:'12345678', en:'12345678', uk:'12345678'},
          {de:'password', en:'password', uk:'password'},
          {de:'M7!qP2#zL9', en:'M7!qP2#zL9', uk:'M7!qP2#zL9'},
          {de:'max2020', en:'max2020', uk:'max2020'}
        ], correct: 2,
        hint: {de:'Länge und eine Mischung verschiedener Zeichen erhöhen die Sicherheit.', en:'Length and a mix of character types improve security.', uk:'Довжина та поєднання різних типів символів підвищують безпеку.'}
      },
      {
        topic: 'Dateien',
        q: {de:'Welche Dateiendung gehört typischerweise zu einer PDF-Datei?', en:'Which file extension is typically used for a PDF document?', uk:'Яке розширення зазвичай має PDF-документ?'},
        options: [
          {de:'.pdf', en:'.pdf', uk:'.pdf'},
          {de:'.mp3', en:'.mp3', uk:'.mp3'},
          {de:'.jpg', en:'.jpg', uk:'.jpg'},
          {de:'.exe', en:'.exe', uk:'.exe'}
        ], correct: 0,
        hint: {de:'Die Dateiendung entspricht dem Formatnamen.', en:'The extension matches the format name.', uk:'Розширення збігається з назвою формату.'}
      },
      {
        topic: 'Cloud',
        q: {de:'Was bedeutet Cloud-Speicher?', en:'What is cloud storage?', uk:'Що таке хмарне сховище?'},
        options: [
          {de:'Speicherplatz auf entfernten Servern über das Internet', en:'Storage on remote servers accessed via the internet', uk:'Сховище на віддалених серверах через інтернет'},
          {de:'Nur Speicher auf einer lokalen Festplatte', en:'Only storage on a local hard drive', uk:'Лише сховище на локальному диску'},
          {de:'Ein spezieller Monitor', en:'A special monitor', uk:'Спеціальний монітор'},
          {de:'Ein Druckverfahren', en:'A printing method', uk:'Спосіб друку'}
        ], correct: 0,
        hint: {de:'Beispiele sind OneDrive, Google Drive und iCloud.', en:'Examples include OneDrive, Google Drive and iCloud.', uk:'Приклади: OneDrive, Google Drive та iCloud.'}
      },
      {
        topic: 'Ergonomie',
        q: {de:'Welche Maßnahme ist bei längerer Computerarbeit sinnvoll?', en:'Which measure is sensible during long periods of computer work?', uk:'Що корисно робити під час тривалої роботи за комп’ютером?'},
        options: [
          {de:'Regelmäßige Pausen machen', en:'Take regular breaks', uk:'Регулярно робити перерви'},
          {de:'Den Bildschirm maximal hell stellen', en:'Set the screen to maximum brightness', uk:'Встановити максимальну яскравість'},
          {de:'Immer in derselben Haltung sitzen', en:'Always sit in the same position', uk:'Завжди сидіти в одній позі'},
          {de:'Den Monitor sehr nah ans Gesicht stellen', en:'Place the monitor very close to your face', uk:'Поставити монітор дуже близько до обличчя'}
        ], correct: 0,
        hint: {de:'Abwechslung und kurze Unterbrechungen entlasten Augen und Körper.', en:'Changing posture and taking short breaks reduces strain.', uk:'Зміна пози та короткі перерви зменшують навантаження.'}
      },
      {
        topic: 'Umwelt',
        q: {de:'Welche Maßnahme spart typischerweise Energie?', en:'Which action typically saves energy?', uk:'Яка дія зазвичай економить енергію?'},
        options: [
          {de:'Geräte bei Nichtbenutzung ausschalten', en:'Turn devices off when not in use', uk:'Вимикати пристрої, коли вони не використовуються'},
          {de:'Bildschirm dauerhaft eingeschaltet lassen', en:'Leave the screen on permanently', uk:'Залишати екран завжди увімкненим'},
          {de:'Jede Datei ausdrucken', en:'Print every file', uk:'Друкувати кожен файл'},
          {de:'Mehrere Ladegeräte ständig eingesteckt lassen', en:'Keep several chargers plugged in all the time', uk:'Постійно тримати кілька зарядних пристроїв у розетці'}
        ], correct: 0,
        hint: {de:'Nicht benötigte Geräte verbrauchen sonst oft weiterhin Strom.', en:'Unused devices can still consume electricity.', uk:'Невикористовувані пристрої можуть продовжувати споживати електроенергію.'}
      }
    ];

    let quizData = [];
    let currentLang = 'de';
    let isPracticeMode = true;
    let timerInterval = null;
    let timeLeft = 45 * 60;
    let quizEvaluated = false;
    const answers = new Map();

    document.addEventListener('DOMContentLoaded', () => {
      shuffleAndReset();
      changeLanguage(currentLang);
    });

    function shuffle(array) {
      const copy = [...array];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function shuffleQuestion(q) {
      const indexed = q.options.map((option, index) => ({ option, index }));
      const mixed = shuffle(indexed);
      return {
        ...q,
        options: mixed.map(x => x.option),
        correct: mixed.findIndex(x => x.index === q.correct)
      };
    }

    function initializeQuiz() {
      const container = document.getElementById('quiz-questions');
      container.innerHTML = '';

      quizData.forEach((item, qIndex) => {
        const card = document.createElement('article');
        card.className = 'question-card';
        card.dataset.index = qIndex;

        const optionsHtml = item.options.map((option, oIndex) => `
          <label class="option-item" data-option="${oIndex}">
            <input type="radio" name="question-${qIndex}" value="${oIndex}" ${answers.get(qIndex) === oIndex ? 'checked' : ''} onchange="selectAnswer(${qIndex}, ${oIndex})">
            <span>${escapeHtml(option[currentLang])}</span>
          </label>
        `).join('');

        card.innerHTML = `
          <div class="question-top">
            <span class="topic-badge">${escapeHtml(item.topic)}</span>
            <span class="question-number">${qIndex + 1} / ${quizData.length}</span>
          </div>
          <div class="question-text">${escapeHtml(item.q[currentLang])}</div>
          <div class="options-list">${optionsHtml}</div>
          ${isPracticeMode ? `<button class="hint-btn" type="button" onclick="toggleHint(${qIndex})">${translations[currentLang].hint}</button><div id="hint-${qIndex}" class="hint-text">${escapeHtml(item.hint[currentLang])}</div>` : ''}
          <div id="feedback-${qIndex}" class="feedback"></div>
        `;

        container.appendChild(card);
        updateSelectedStyle(qIndex);
      });
      updateProgress();
    }

    function selectAnswer(qIndex, optionIndex) {
      if (quizEvaluated) return;
      answers.set(qIndex, optionIndex);
      updateSelectedStyle(qIndex);
      updateProgress();

      if (isPracticeMode) {
        showFeedback(qIndex, optionIndex);
      }
    }

    function updateSelectedStyle(qIndex) {
      const card = document.querySelector(`.question-card[data-index="${qIndex}"]`);
      if (!card) return;
      card.querySelectorAll('.option-item').forEach(el => {
        el.classList.toggle('selected-pre', Number(el.dataset.option) === answers.get(qIndex) && !quizEvaluated);
      });
    }

    function showFeedback(qIndex, optionIndex) {
      const item = quizData[qIndex];
      const feedback = document.getElementById(`feedback-${qIndex}`);
      const isCorrect = optionIndex === item.correct;
      feedback.textContent = isCorrect ? translations[currentLang].correct : translations[currentLang].wrong;
      feedback.className = `feedback show ${isCorrect ? 'correct-feedback' : 'incorrect-feedback'}`;
    }

    function toggleHint(qIndex) {
      const hint = document.getElementById(`hint-${qIndex}`);
      if (hint) hint.classList.toggle('show');
    }

    function calculateScore(force = false) {
      const t = translations[currentLang];
      if (!force && answers.size < quizData.length) {
        alert(t.unanswered);
        return;
      }

      quizEvaluated = true;
      stopTimer();
      let score = 0;

      quizData.forEach((item, qIndex) => {
        const selected = answers.get(qIndex);
        const card = document.querySelector(`.question-card[data-index="${qIndex}"]`);
        const optionEls = card.querySelectorAll('.option-item');

        optionEls.forEach((el, oIndex) => {
          el.classList.remove('selected-pre');
          if (oIndex === item.correct) el.classList.add('correct');
          if (selected === oIndex && selected !== item.correct) el.classList.add('incorrect');
        });

        card.querySelectorAll('input').forEach(input => input.disabled = true);
        if (selected === item.correct) score++;
        if (!isPracticeMode) showFeedback(qIndex, selected);
      });

      const percent = Math.round((score / quizData.length) * 100);
      let message = t.improve;
      if (percent >= 85) message = t.excellent;
      else if (percent >= 65) message = t.good;

      const result = document.getElementById('result-box');
      result.innerHTML = `
        <div class="result-score">${t.result}: ${score} ${t.of} ${quizData.length}</div>
        <div>${percent}% – ${message}</div>
        <div class="result-meta">${score} ${t.of} ${quizData.length} ${t.points}</div>
      `;
      result.classList.add('show');
      result.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function shuffleAndReset() {
      stopTimer();
      answers.clear();
      quizEvaluated = false;
      timeLeft = 45 * 60;
      quizData = shuffle(originalQuizData).map(shuffleQuestion);
      document.getElementById('result-box').classList.remove('show');
      document.getElementById('result-box').innerHTML = '';
      initializeQuiz();
      updateTimerDisplay();
      if (!isPracticeMode) startTimer();
    }

    function toggleExamMode() {
      isPracticeMode = document.getElementById('mode-checkbox').checked;
      quizEvaluated = false;
      answers.clear();
      timeLeft = 45 * 60;
      document.getElementById('timer-box').style.display = isPracticeMode ? 'none' : 'block';
      stopTimer();
      if (!isPracticeMode) startTimer();
      changeLanguage(currentLang);
      initializeQuiz();
    }

    function changeLanguage(lang) {
      currentLang = lang;
      document.documentElement.lang = lang;
      const t = translations[lang];
      document.getElementById('ui-title').textContent = t.title;
      document.getElementById('ui-subtitle').textContent = t.subtitle;
      document.getElementById('ui-progress-label').textContent = t.progress;
      document.getElementById('ui-mode-text').textContent = isPracticeMode ? t.practice : t.exam;
      document.getElementById('ui-btn-shuffle').textContent = t.shuffle;
      document.getElementById('calc-score-btn').textContent = t.evaluate;
      document.getElementById('lang-select').value = lang;
      document.getElementById('timer-box').style.display = isPracticeMode ? 'none' : 'block';
      initializeQuiz();
    }

    function updateProgress() {
      const total = quizData.length || 1;
      const answered = answers.size;
      const percent = Math.round((answered / total) * 100);
      document.getElementById('progress-bar').style.width = `${percent}%`;
      document.getElementById('progress-text').textContent = `${answered} / ${total} ${translations[currentLang].answered}`;
    }

    function startTimer() {
      stopTimer();
      updateTimerDisplay();
      timerInterval = setInterval(() => {
        timeLeft--;
        updateTimerDisplay();
        if (timeLeft <= 0) {
          stopTimer();
          calculateScore(true);
        }
      }, 1000);
    }

    function stopTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = null;
    }

    function updateTimerDisplay() {
      const minutes = String(Math.floor(timeLeft / 60)).padStart(2, '0');
      const seconds = String(timeLeft % 60).padStart(2, '0');
      document.getElementById('timer-box').textContent = `⏱️ ${minutes}:${seconds}`;
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }
  </script>
</body>
</html>
